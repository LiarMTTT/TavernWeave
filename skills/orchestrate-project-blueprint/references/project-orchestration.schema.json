{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liarmttt.github.io/TavernWeave/schemas/project-orchestration-v1.json",
  "title": "TavernWeave Project Orchestration Authority",
  "type": "object",
  "required": ["schemaVersion", "authoritySchema", "projectId", "title", "profile", "state", "authorityFile", "nextFile", "blueprintPolicy", "runtimeRefinementPolicy", "runtimeRefinements", "discussionDirections", "frontendDecision", "acceptance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "authoritySchema": { "const": "tavernweave/project-orchestration/v1" },
    "projectId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "profile": { "enum": ["single-blueprint", "blueprint-set", "program-blueprint-set"] },
    "state": { "enum": ["brainstorm-candidate", "driver-approved-design", "implementation-candidate", "automated-evidence", "real-host-evidence", "driver-accepted"] },
    "authorityFile": { "type": "string", "minLength": 1 },
    "nextFile": { "type": "string", "minLength": 1 },
    "blueprintPolicy": {
      "type": "object",
      "required": ["masterFile", "maxDepth", "maxChildren", "runtimePersistentBlueprintBudget", "blueprints"],
      "properties": {
        "maxDepth": { "type": "integer", "minimum": 1, "maximum": 3 },
        "maxChildren": { "type": "integer", "minimum": 0, "maximum": 9 },
        "runtimePersistentBlueprintBudget": { "const": 0 },
        "blueprints": { "type": "array", "minItems": 1 }
      }
    },
    "runtimeRefinementPolicy": {
      "type": "object",
      "required": ["trigger", "maxDepth", "maxOpenBranches", "persistent", "mayExpandProductScope", "mustReturnToParent"],
      "properties": {
        "trigger": { "const": "observed-problem-or-failed-exit-condition" },
        "maxDepth": { "const": 1 },
        "maxOpenBranches": { "const": 1 },
        "persistent": { "const": false },
        "mayExpandProductScope": { "const": false },
        "mustReturnToParent": { "const": true }
      }
    },
    "runtimeRefinements": { "type": "array" }
  }
}
