{
  "schemaVersion": 1,
  "adapterVersion": "2.1.0",
  "hosts": {
    "codex": {
      "displayName": "Codex",
      "instructionFileName": "AGENTS.md",
      "defaultDirectory": ".codex",
      "homeOverrideEnvironment": "CODEX_HOME",
      "rediscovery": "new-task-or-restart",
      "support": "formal"
    },
    "claude": {
      "displayName": "Claude Code",
      "instructionFileName": "CLAUDE.md",
      "defaultDirectory": ".claude",
      "homeOverrideEnvironment": "CLAUDE_CONFIG_DIR",
      "rediscovery": "new-task-or-restart",
      "support": "formal",
      "pluginFrontDoorMechanism": "plugin-session-start-hook",
      "pluginFrontDoorDedup": "instruction-file-block-wins",
      "presetAgent": "tavernweave-agent-skills:tavernweave"
    },
    "dsh": {
      "displayName": "DeepSeek Harness",
      "instructionFileName": null,
      "defaultDirectory": null,
      "homeOverrideEnvironment": null,
      "rediscovery": "new-session",
      "support": "plugin-bundle",
      "frontDoorMechanism": "plugin-system-prompt",
      "pluginPackage": "liarmttt-tavernweave-dsh",
      "presetId": "tavernweave"
    }
  }
}
